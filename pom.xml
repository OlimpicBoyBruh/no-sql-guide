<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.nosqlguide</groupId>
    <artifactId>nosql-guide-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>NoSQL Java Guide</name>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- тесты с тегом slow (например, кластер Cassandra) по умолчанию не запускаются;
             включить: -Dgroups=slow -DexcludedGroups=
             (используем стандартное свойство excludedGroups, которое Surefire читает
             по умолчанию для параметра excludedGroups, чтобы -D из командной строки
             могло его переопределить; свой pluginManagement-конфиг сюда не добавляем,
             иначе явная конфигурация плагина перекроет -D) -->
        <excludedGroups>slow</excludedGroups>
    </properties>

    <!-- По умолчанию собираются examples и solutions: зелёная сборка = материал корректен.
         Модули добавляются в планах 2–4. -->
    <modules>
    </modules>

    <profiles>
        <!-- Профиль для студента: добавляет модули с заданиями (их тесты падают, пока задания не решены). -->
        <profile>
            <id>tasks</id>
            <modules>
            </modules>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>Нужна Java 21+. Укажите JAVA_HOME на JDK 21.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
